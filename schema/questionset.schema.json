{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://apololifter.github.io/hypo-questions/schema/questionset.schema.json",
  "title": "QuestionSet",
  "description": "Conjunto de preguntas asociado a un nodo del arbol WPTA (area, familia o tecnica). Un questions.yaml = un QuestionSet.",
  "type": "object",
  "required": ["schema_version", "node_type", "id", "wpta", "questions"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "node_type": { "type": "string", "enum": ["area", "family", "technique"] },
    "id": {
      "type": "string",
      "description": "ID del nodo: area code (D), family id (F-D01) o technique id (TEC-0003)."
    },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "area": { "type": "string" },
    "area_title": { "type": "string" },
    "family_id": { "type": ["string", "null"] },
    "family_name": { "type": ["string", "null"] },
    "technique_id": { "type": ["string", "null"] },
    "variant_of": { "type": ["string", "null"] },
    "hypothesis": { "type": ["string", "null"] },
    "behavior": { "type": ["string", "null"] },
    "patterns": { "type": "array", "items": { "type": "string" } },
    "related_techniques": { "type": "array", "items": { "type": "string" } },
    "attacker_state_requirements": { "type": "array", "items": { "type": "string" } },
    "missing_catalog_fields": {
      "type": "array",
      "description": "Campos del WPTA ausentes que impedirian preguntas mas precisas.",
      "items": { "type": "string" }
    },
    "subfamilies": { "type": "array", "items": { "type": "string" } },
    "techniques": { "type": "array", "items": { "type": "string" } },
    "standard_version": { "type": "string", "description": "Version del estandar de autoria (AUTHORING.md) aplicada." },
    "authored": { "type": "boolean", "description": "true si el nodo fue revisado/escrito segun el estandar (no es un seed generado)." },
    "reviewed": { "type": "boolean" },
    "mechanism": {
      "type": "object",
      "description": "Descomposicion del mecanismo (Paso 1 del estandar).",
      "additionalProperties": false,
      "properties": {
        "invariant": { "type": "string", "description": "Propiedad de seguridad que debe cumplirse." },
        "preconditions": { "type": "array", "items": { "type": "string" } },
        "components": { "type": "array", "items": { "type": "string" } },
        "sources": { "type": "array", "items": { "type": "string" } },
        "transformations": { "type": "array", "items": { "type": "string" } },
        "controls": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "check": { "type": "string" },
              "applies_to": { "type": "array", "items": { "type": "string" } },
              "bypass_candidates": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "discriminating_test": {
      "type": "object",
      "description": "Prueba discriminante minima (Paso 6 del estandar).",
      "additionalProperties": false,
      "properties": {
        "baseline": { "type": "string" },
        "change": { "type": "string" },
        "constant": { "type": "array", "items": { "type": "string" } },
        "expected_secure": { "type": "string" },
        "anomalous": { "type": "string" },
        "signal": { "type": "string" },
        "confirmation_criteria": { "type": "string" },
        "falsation": { "type": "string" }
      }
    },
    "alternative_paths": {
      "type": "array",
      "description": "Caminos alternativos considerados (Paso 3) y la pregunta que los cubre.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "dimension": { "type": "string" },
          "variation": { "type": "string" },
          "question_id": { "type": "string" }
        }
      }
    },
    "wpta": {
      "type": "object",
      "required": ["repo", "commit"],
      "additionalProperties": false,
      "properties": {
        "repo": { "type": "string" },
        "commit": { "type": "string" },
        "source": { "type": "string" }
      }
    },
    "generated": { "type": "boolean" },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "question.schema.json" }
    }
  }
}
